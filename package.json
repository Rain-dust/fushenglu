{
  "name": "moji-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "check": "node --check app.js && node --check server.js",
    "build:web": "node scripts/prepare-capacitor-web.js",
    "cap:sync": "npm run build:web && npx cap sync android",
    "apk:debug:win": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  }
}
